const express = require('express');
const app = express();
const port = process.env.PORT || 3000;

app.get('/', (req, res) => {
  res.send(`
    <h1>Hello from my cloud application deployed using AWS!</h1>
    <p>This is my cloud computing project.</p>
  `);
});

app.listen(port, () => {
  console.log(`Server is running on http://localhost:${port}`);
});
